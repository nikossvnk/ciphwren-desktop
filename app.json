{
  "expo": {
    "name": "Ciphwren Desktop",
    "slug": "ciphwren_desktop",
    "version": "1.9.0",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ciphwren.desktop"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#0B1F33"
    },
    "platforms": [
      "ios",
      "web"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-font",
      ["expo-splash-screen", {
        "image": "./assets/splash.png",
        "imageWidth": 128,
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/splash-dark.png",
          "backgroundColor": "#0B1F33"
        }
      }]
    ]
  }
}
